cartPaypal = PAGE
cartPaypal {
    typeNum = {$plugin.tx_cartpaypal.redirectTypeNum}

    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
        no_cache = 1
    }

    10 = EXTBASEPLUGIN
    10 {
        extensionName = CartPaypal
        pluginName = Api
    }
}

plugin.tx_cartpaypal {
    redirectTypeNum = {$plugin.tx_cartpaypal.redirectTypeNum}

    settings {
        paymentPid = {$plugin.tx_cartpaypal.paymentPid}
        brandName = {$plugin.tx_cartpaypal.brandName}
        locale = {$plugin.tx_cartpaypal.locale}
        shippingPreference = {$plugin.tx_cartpaypal.shippingPreference}
    }
}
