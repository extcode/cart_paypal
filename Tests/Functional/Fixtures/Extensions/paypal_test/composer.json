    "description": "Mocks the PayPal API and records the events of cart_paypal in functional tests",
    "license": [
        "GPL-2.0-or-later"
    ],
    "autoload": {
        "psr-4": {
            "Extcode\\PaypalTest\\": "Classes/"
        }
